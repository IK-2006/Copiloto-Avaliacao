# Copie para .env e preencha. O arquivo .env NUNCA vai para o git.

# Sem chave, o app roda no modo "Regras" (offline). Com chave, usa o Claude.
ANTHROPIC_API_KEY=

# Modelos usados quando houver chave
COPILOTO_MODELO_CLASSIFICACAO=claude-haiku-5-5
COPILOTO_MODELO_GERACAO=claude-sonnet-5-5

# Limite diário de chamadas ao Claude (proteção do demo público)
COPILOTO_LIMITE_DIARIO_LLM=200

# Caminho do banco SQLite com os dados fictícios
COPILOTO_DB=data/restaurante.db

# --- API do resumo semanal e n8n (docker-compose.yml) ---
# Token que o n8n envia no cabeçalho X-API-Token. Gere um valor longo e aleatório.
COPILOTO_API_TOKEN=
# Chave de criptografia das credenciais do n8n (guarde: sem ela as credenciais salvas ficam ilegíveis).
N8N_ENCRYPTION_KEY=
# Para quem o resumo é enviado e o remetente. O servidor SMTP é configurado como credencial no n8n.
RESUMO_EMAIL_PARA=
RESUMO_EMAIL_DE=
# Link do dashboard que aparece no fim do e-mail (opcional).
COPILOTO_DASHBOARD_URL=
